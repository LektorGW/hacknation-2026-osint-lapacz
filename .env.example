# OŁCyŚ — wzór konfiguracji. Najprościej utworzyć `.env` kreatorem: pnpm run setup
# Ręcznie: skopiuj ten plik do `.env` i odkomentuj tylko to, czego potrzebujesz.
# Żadna zmienna nie jest wymagana: bez nich narzędzie działa wyłącznie na danych syntetycznych
# z piaskownicy (apps/sandbox). Plik `.env` jest poza repozytorium (.gitignore, .dockerignore).
# Ten plik nie zawiera żadnych prawdziwych wartości — tylko wartości domyślne i przykłady postaci.
#
# Wszystkie wiersze są zakomentowane celowo: zmienna ustawiona na pustą wartość NIE jest tym samym,
# co zmienna nieustawiona (np. pusty API_PORT albo pusty SANDBOX_URL zmienia zachowanie serwera).
#
# Kto czyta `.env`:
#   pnpm start / pnpm start:demo / pnpm dev / pnpm run doctor / pnpm run backup — wczytują `.env` z katalogu głównego
#     (inny plik: --config <ścieżka>); zmienne ustawione w terminalu mają pierwszeństwo;
#     ścieżki względne (OLCYS_DATA_DIR, OLCYS_WEB_DIR, OLCYS_BACKUP_DIR) liczone są od katalogu głównego repozytorium.
#   docker compose — przekazuje `.env` do kontenera (ścieżki i porty kontenera ustawia docker-compose.yml).
#   Samo API (`node src/server.ts` w apps/api) nie wczytuje `.env`: node --env-file=../../.env src/server.ts
# Opis: docs/WDROZENIE.md (tabela konfiguracji) i README.md („Zmienne środowiskowe”).

# ---------- Serwer ----------
# Port i adres nasłuchu API (i interfejsu w trybie produkcyjnym). 0.0.0.0 = dostęp z sieci — ustaw wtedy token API.
# API_PORT=4000
# API_HOST=127.0.0.1
# Interfejs (apps/web/dist) podawany przez API na tym samym porcie: 1 = tak, 0 = nie.
# Domyślnie: tak przy NODE_ENV=production i zbudowanym interfejsie (pnpm start ustawia oba).
# OLCYS_SERVE_WEB=1
# Katalog zbudowanego interfejsu (domyślnie apps/web/dist).
# OLCYS_WEB_DIR=apps/web/dist
# NODE_ENV=production
# 1 = „pnpm start” uruchamia także piaskownicę (dane syntetyczne) i ustawia SANDBOX_URL na jej adres.
# OLCYS_START_SANDBOX=1
# Ile ms skrypt uruchomieniowy czeka na łagodne zamknięcie API, zanim je przerwie (domyślnie 120000).
# OLCYS_STOP_TIMEOUT_MS=120000
# 1 = pomija sprawdzenie konfiguracji przy starcie API (niezalecane; diagnoza: pnpm run doctor).
# OLCYS_SKIP_CONFIG_CHECK=0

# ---------- Zabezpieczenia ----------
# Token API (co najmniej 16 znaków; kreator generuje 43). Każde żądanie /api/* wymaga nagłówka
# Authorization: Bearer <token> (wyjątek: /api/health). Bez tokenu — brak uwierzytelniania (stanowisko lokalne).
# Generowanie: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# OLCYS_API_TOKEN=
# Dodatkowe nazwy hosta, pod którymi API jest otwierane (nagłówek Host), po przecinku. Adresy IP i localhost — zawsze.
# OLCYS_ALLOWED_HOSTS=olcys.kas.local
# Adresy (origin) osobno hostowanego interfejsu dopuszczone przez CORS, po przecinku (domyślnie serwer Vite :5173/:4173).
# OLCYS_WEB_ORIGIN=http://localhost:5173
# Limit kosztownych żądań (analiza, eksport, archiwum) na adres IP na minutę; 0 wyłącza (domyślnie 30).
# OLCYS_RATE_LIMIT_PER_MIN=30

# ---------- Baza danych ----------
# Katalog danych wbudowanej bazy PGlite (domyślnie ./data/pg względem apps/api).
# Migawka bazy powstaje obok: <katalog>.migawka.tar.gz. Katalogi `.data*` są objęte przez .gitignore.
# OLCYS_DATA_DIR=.data-olcys/pg
# Klucz szyfrowania migawki AES-256-GCM: 32 bajty (64 znaki szesnastkowe albo base64). Bez klucza migawka jest jawna.
# ZRÓB KOPIĘ KLUCZA — bez niego zaszyfrowanej migawki nie da się odczytać.
# Generowanie: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OLCYS_SNAPSHOT_KEY=
# Zewnętrzny PostgreSQL (14 lub nowszy). Gdy podany, PGlite nie jest używany.
# DATABASE_URL=postgres://uzytkownik:haslo@localhost:5432/olcys

# ---------- Kopie, retencja, archiwa ----------
# Katalog kopii zapasowych (pnpm run backup; domyślnie <katalog nad OLCYS_DATA_DIR>/kopie) i liczba zachowanych kopii.
# OLCYS_BACKUP_DIR=.data-olcys/kopie
# OLCYS_BACKUP_KEEP=7
# Po ilu dniach od zamknięcia usuwać sprawy (1–36500). Brak = retencja wyłączona.
# OLCYS_RETENTION_DAYS_CLOSED=365
# Katalog, w którym serwer przechowuje pliki archiwów spraw. Brak = archiwum tylko do pobrania (w bazie sam skrót SHA-256).
# OLCYS_ARCHIVE_DIR=.data-olcys/archiwa

# ---------- Źródła danych ----------
# Adres piaskownicy z danymi syntetycznymi. Pusta wartość („SANDBOX_URL=”) wyłącza piaskownicę.
# SANDBOX_URL=http://localhost:4100
# 1 / true / yes włącza źródła i eksploratory w prawdziwym internecie. Domyślnie wyłączone.
# ENABLE_LIVE=1
# Kontakt w nagłówku User-Agent (e-mail albo strona) — wymagany przez zasady Wikimedia (Wikidata) przy ENABLE_LIVE.
# OLCYS_CONTACT=zespol@example.org
# Token GitHub bez uprawnień — wyższy limit zapytań i wyszukiwarka GitHuba. Opcjonalny.
# GITHUB_TOKEN=
# Token JWT API v3 Hurtowni danych CEIDG — łącznik live-ceidg. Opcjonalny.
# CEIDG_API_TOKEN=
# Klucz API Blockscout — sieci dostępne tylko z kluczem (Arbitrum, Gnosis), zapasowa droga dla Ethereum. Opcjonalny.
# BLOCKSCOUT_API_KEY=
# Klucz Marginalia Search („public” = klucz wspólny) — włącza web-search. Opcjonalny.
# MARGINALIA_API_KEY=
# Klucz Mojeek; dostawca powstaje tylko z MOJEEK_STORAGE_RIGHTS=1 (plan z prawem przechowywania wyników).
# MOJEEK_API_KEY=
# MOJEEK_STORAGE_RIGHTS=1
# Przekaźniki Nostr (wss://…, po przecinku), których zasady operator zaakceptował.
# NOSTR_RELAYS=
# Własny węzeł Snapchain dla live-farcaster.
# FARCASTER_HUB_URL=
# Adres proxy HTTP Tora (HTTPTunnelPort). Bez tej zmiennej Tor jest wyłączony (domyślnie).
# TOR_PROXY_URL=http://127.0.0.1:8118
# Adres laboratorium tożsamości (apps/identity-lab). Bez tej zmiennej wyłączone (domyślnie).
# LAB_URL=http://127.0.0.1:8787

# ---------- Indeks publikacji monitoringu ----------
# CORPUS_RETENTION_DAYS=30
# CORPUS_MAX_ROWS=200000

# ---------- Model językowy (opcjonalny, domyślnie wyłączony) ----------
# Dostawca: openai-compatible (także: openai) | anthropic | none
# AI_PROVIDER=openai-compatible
# Adres API; wymagany dla openai-compatible. Model lokalny: Ollama http://127.0.0.1:11434/v1, LM Studio http://127.0.0.1:1234/v1.
# Przy adresie spoza tej maszyny dane analizy (fragmenty publikacji) są wysyłane do wskazanego dostawcy.
# AI_BASE_URL=http://127.0.0.1:11434/v1
# Nazwa modelu; wymagana dla openai-compatible.
# AI_MODEL=
# Klucz API; wymagany dla anthropic, zbędny dla serwerów lokalnych.
# AI_API_KEY=
# Skróty: sam OPENAI_API_KEY włącza openai-compatible z adresem OpenAI (AI_MODEL i tak trzeba podać),
# sam ANTHROPIC_API_KEY włącza anthropic. Oba naraz bez AI_PROVIDER = model wyłączony.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Limit czasu zadania w ms, długość treści wysyłanej do modelu, liczba zadań naraz.
# AI_TIMEOUT_MS=30000
# AI_MAX_INPUT_CHARS=6000
# AI_CONCURRENCY=4
# Tylko anthropic: głębokość rozumowania (low | medium | high | xhigh | max); 0 wyłącza model zastępczy po odmowie.
# AI_EFFORT=low
# AI_REFUSAL_FALLBACK=0

# ---------- Piaskownica (proces apps/sandbox) ----------
# SANDBOX_PORT=4100
# SANDBOX_HOST=localhost

# ---------- Tryb deweloperski (pnpm dev) ----------
# Port serwera Vite (przekierowuje /api do API_PORT).
# VITE_PORT=5173
# 1 przy budowaniu interfejsu — tryb na danych wbudowanych, bez API.
# VITE_DEMO=1

# ---------- Docker Compose (tylko interpolacja w docker-compose.yml) ----------
# Adres i porty hosta, na których compose wystawia kontener (domyślnie wyłącznie 127.0.0.1).
# OLCYS_BIND=127.0.0.1
# OLCYS_PORT=4000
# OLCYS_SANDBOX_PORT=4100
# Hasło bazy w profilu „postgres” (wtedy DATABASE_URL=postgres://olcys:<hasło>@postgres:5432/olcys).
# POSTGRES_PASSWORD=

# ---------- Laboratorium tożsamości (proces apps/identity-lab) ----------
# PORT=8787
# LAB_DATA_DIR=
